<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- ✅ Forward HTTPS and Host info to Flask via headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Forwarded-Proto" value="https" />
        <add name="X-Forwarded-Host" value="visitor.orientindia.net:5011" />
      </customHeaders>
    </httpProtocol>

    <!-- ✅ Reverse proxy all traffic to internal Flask server -->
    <rewrite>
      <rules>
        <rule name="ReverseProxyInboundRule1" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:9011/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- ✅ Optional: handle FastCGI if directly running Flask via wfastcgi (commented out) -->
    <!--
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\Path\To\python.exe|C:\Path\To\Lib\site-packages\wfastcgi.py"
           resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    -->

  </system.webServer>
</configuration>
